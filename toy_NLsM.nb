Cell[BoxData[
 RowBox[{
  RowBox[{"IteraSolveLin", ":=", 
   RowBox[{"(", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dsol", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dmaxite", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dmax", "=", "1."}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"dmax", ">", 
        SuperscriptBox["10", 
         RowBox[{"-", "5"}]]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"n\[Psi]", "[", 
          RowBox[{"-", "Lm"}], "]"}], "=", "   ", 
         RowBox[{"m", "  ", 
          SuperscriptBox["E", 
           RowBox[{"-", "H", " "}]], 
          RowBox[{"\[Psi]", "[", 
           RowBox[{"-", "Lm"}], "]"}]}]}], ";", " ", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "linearizziamo", " ", "questo", " ", "lo", " ", "fa", " ", 
           "decrescere"}], ",", "  ", 
          RowBox[{
           RowBox[{"m", "  ", 
            SuperscriptBox["E", 
             RowBox[{"-", "H", " "}]], "\[EGrave]", " ", "minore", " ", "di", 
            " ", "uno", " ", "per", " ", "H"}], "=", "1"}]}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"int", "=", 
            RowBox[{
             FractionBox["3", "16"], 
             SuperscriptBox["E", "J"], "m", "  ", 
             RowBox[{"\[Psi]", "[", 
              RowBox[{"-", "Lm"}], "]"}], "  ", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{
                SuperscriptBox["H", "2"], 
                SuperscriptBox["E", 
                 RowBox[{
                  RowBox[{"-", "2"}], " ", "t"}]]}]}], ")"}], 
             SuperscriptBox[
              RowBox[{"(", " ", 
               RowBox[{"J", " ", 
                RowBox[{
                 SuperscriptBox["E", "t"], "/", "H"}]}], ")"}], "2"], 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "J"}], "  ", 
               RowBox[{
                SuperscriptBox["E", "t"], "/", "H"}]}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"contributo", " ", 
               RowBox[{"all", "'"}], "integrale", " ", "in", " ", "tt", " ", 
               "di", " ", "di", " ", "tt"}], "=", 
              RowBox[{"-", "Lm"}]}], ",", " ", 
             RowBox[{
              RowBox[{
              "bisogna", " ", "farlo", " ", "usando", " ", "il", " ", 
               "limite", " ", "per", " ", "la", " ", "Bessel", " ", "a", " ", 
               "x"}], "=", "0"}]}], " ", "*)"}], "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
