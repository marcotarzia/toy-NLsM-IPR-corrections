Cell[BoxData[
 RowBox[{
  RowBox[{"IteraSolve0", ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Pite", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dsol", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dmaxite", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dmax", "=", "1."}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"dmax", ">", 
        SuperscriptBox["10", 
         RowBox[{"-", "7"}]]}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"n\[Psi]", "[", 
          RowBox[{"-", "Lm"}], "]"}], "=", " ", "1."}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"int", "=", "0"}], ";", "\[IndentingNewLine]", 
           RowBox[{
           "Do", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"y", "=", 
               RowBox[{
                RowBox[{"-", "J"}], " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   SuperscriptBox["E", 
                    RowBox[{"t", "-", " ", "tt"}]], "+", 
                   SuperscriptBox["E", 
                    RowBox[{"tt", "-", " ", "t"}]]}], ")"}], " ", "/", 
                 "2"}]}]}], 
              RowBox[{"(*", " ", 
               RowBox[{
               "viene", " ", "dal", " ", "limite", " ", "per", " ", "H", " ", 
                RowBox[{"piccolo", ":", " ", 
                 RowBox[{
                  RowBox[{"tende", "  ", "a"}], " ", "-", 
                  RowBox[{"J", " ", 
                   RowBox[{"Cosh", "[", 
                    RowBox[{"t", "-", "tt"}], "]"}]}]}]}]}], " ", "*)"}], ";",
               "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"int", "+=", 
               RowBox[{
                FractionBox[
                 RowBox[{
                  SuperscriptBox["J", 
                   RowBox[{"1", "/", "2"}]], 
                  SuperscriptBox["E", "J"]}], 
                 SuperscriptBox[
                  RowBox[{"(", 
                   RowBox[{"2", " ", "\[Pi]"}], ")"}], 
                  RowBox[{"1", "/", "2"}]]], 
                SuperscriptBox[
                 RowBox[{"\[Psi]", "[", "tt", "]"}], "m"], " ", 
                SuperscriptBox["E", 
                 RowBox[{"-", 
                  SuperscriptBox["E", "tt"]}]], " ", 
                RowBox[{"Exp", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"t", "-", "tt"}], ")"}], "/", "2"}], "+", "y"}], 
                 "]"}]}]}], ";"}], "\[IndentingNewLine]", 
             RowBox[{"(*", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Log", "[", 
                 RowBox[{"BesselI", "[", 
                  RowBox[{"1", ",", "x"}], "]"}], "]"}], "-", "x", "+", 
                RowBox[{
                 RowBox[{"Log", "[", 
                  RowBox[{"2", "\[Pi]"}], "]"}], "/", "2"}], "+", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Log", "[", "x", "]"}], "/", "2"}], " ", "tende", 
                 " ", "a", " ", "zero", " ", "per", " ", "x", " ", "che", " ",
                  "diverge"}]}], ",", " ", 
               RowBox[{
                RowBox[{"cioe", "'"}], " ", "H", " ", "piccolo"}]}], " ", 
              "*)"}], "\[IndentingNewLine]", ",", 
             RowBox[{"{", 
              RowBox[{"tt", ",", 
               RowBox[{
                RowBox[{"-", "Lm"}], "+", "dt"}], ",", "LM", ",", "dt"}], 
              "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"n\[Psi]", "[", "t", "]"}], "=", "  ", 
            RowBox[{"int", " ", "dt"}]}], ";"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{
             RowBox[{"-", "Lm"}], "+", "dt"}], ",", "LM", ",", "dt"}], 
           "}"}]}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"n\[Psi]", "[", "t", "]"}], "=", 
            RowBox[{"1.", "-", 
             RowBox[{"c", " ", 
              SuperscriptBox["E", 
               RowBox[{"b", " ", "t"}]]}]}]}], ";"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"-", "Lm"}], ",", 
            RowBox[{
             RowBox[{"-", "Lm"}], "+", "10"}], ",", "dt"}], "}"}]}], "]"}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"diff\[Psi]", "[", "t", "]"}], "=", 
            RowBox[{
             RowBox[{"\[Psi]", "[", "t", "]"}], "-", 
             RowBox[{"n\[Psi]", "[", "t", "]"}]}]}], ";"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"-", "Lm"}], ",", "LM", ",", "dt"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"dmax", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"diff\[Psi]", "[", "t", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", 
              RowBox[{"-", "Lm"}], ",", "LM", ",", "dt"}], "}"}]}], "]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"dsol", ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"tt", ",", 
              RowBox[{
               RowBox[{"diff\[Psi]", "[", "tt", "]"}], "/", "dmax"}]}], "}"}],
             ",", 
            RowBox[{"{", 
             RowBox[{"tt", ",", 
              RowBox[{"-", "Lm"}], ",", "LM", ",", "dt"}], "}"}]}], "]"}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"dmaxite", ",", "dmax"}], "]"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\[Psi]", "[", "t", "]"}], "=", 
            RowBox[{"n\[Psi]", "[", "t", "]"}]}], ";"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"-", "Lm"}], ",", "LM", ",", "dt"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"P", "=", "0"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"P", "+=", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"\[Psi]", "[", "t", "]"}], 
             RowBox[{"m", "+", "1"}]], " ", 
            SuperscriptBox["E", 
             RowBox[{"-", " ", 
              SuperscriptBox["E", "t"]}]], " ", 
            SuperscriptBox["E", "t"]}]}], " ", ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"-", "Lm"}], ",", "LM", ",", "dt"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"P", "*=", 
         RowBox[{"(", "dt", ")"}]}], ";", " ", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"controllare", " ", "la", " ", "formula"}], ",", " ", 
          RowBox[{
          "manca", " ", "un", " ", "pezzo", " ", "che", " ", "dovrebbe", " ", 
           "dare", " ", "correzioni", " ", "regolari", " ", "in", " ", 
           "H"}]}], "  ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"Pite", ",", "P"}], "]"}], ";"}]}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], ")"}]}], 
  "\[IndentingNewLine]"}]], "Input",
