Cell[BoxData[
 RowBox[{
  RowBox[{"IteraSolveD0", ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dPite", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dsol", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dmaxite", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dmax", "=", "1."}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"dmax", ">", 
        SuperscriptBox["10", 
         RowBox[{"-", "7"}]]}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"nd\[Psi]", "[", 
          RowBox[{"-", "Lm"}], "]"}], "=", " ", ".0"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"int", "=", "0"}], ";", "\[IndentingNewLine]", 
           RowBox[{
           "Do", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"y", "=", 
               RowBox[{
                RowBox[{"-", "J"}], " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   SuperscriptBox["E", 
                    RowBox[{"t", "-", " ", "tt"}]], "+", 
                   SuperscriptBox["E", 
                    RowBox[{"tt", "-", " ", "t"}]]}], ")"}], " ", "/", 
                 "2"}]}]}], 
              RowBox[{"(*", " ", 
               RowBox[{
               "viene", " ", "dal", " ", "limite", " ", "per", " ", "H", " ", 
                RowBox[{"piccolo", ":", " ", 
                 RowBox[{
                  RowBox[{"tende", "  ", "a"}], " ", "-", 
                  RowBox[{"J", " ", 
                   RowBox[{"Cosh", "[", 
                    RowBox[{"t", "-", "tt"}], "]"}]}]}]}]}], " ", "*)"}], ";",
               "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"int", "+=", 
               RowBox[{"m", 
                FractionBox[
                 RowBox[{
                  SuperscriptBox["J", 
                   RowBox[{"1", "/", "2"}]], 
                  SuperscriptBox["E", "J"]}], 
                 SuperscriptBox[
                  RowBox[{"(", 
                   RowBox[{"2", " ", "\[Pi]"}], ")"}], 
                  RowBox[{"1", "/", "2"}]]], 
                RowBox[{"d\[Psi]", "[", "tt", "]"}], " ", 
                SuperscriptBox[
                 RowBox[{"\[Psi]", "[", "tt", "]"}], 
                 RowBox[{"m", "-", "1"}]], " ", 
                SuperscriptBox["E", 
                 RowBox[{"-", 
                  SuperscriptBox["E", "tt"]}]], " ", 
                RowBox[{"Exp", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"t", "-", "tt"}], ")"}], "/", "2"}], "+", "y"}], 
                 "]"}]}]}], ";"}], "\[IndentingNewLine]", 
             RowBox[{"(*", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Log", "[", 
                 RowBox[{"BesselI", "[", 
                  RowBox[{"1", ",", "x"}], "]"}], "]"}], "-", "x", "+", 
                RowBox[{
                 RowBox[{"Log", "[", 
                  RowBox[{"2", "\[Pi]"}], "]"}], "/", "2"}], "+", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Log", "[", "x", "]"}], "/", "2"}], " ", "tende", 
                 " ", "a", " ", "zero", " ", "per", " ", "x", " ", "che", " ",
                  "diverge"}]}], ",", " ", 
               RowBox[{
                RowBox[{"cioe", "'"}], " ", "H", " ", "piccolo"}]}], " ", 
              "*)"}], "\[IndentingNewLine]", ",", 
             RowBox[{"{", 
              RowBox[{"tt", ",", 
               RowBox[{
                RowBox[{"-", "Lm"}], "+", "dt"}], ",", "LM", ",", "dt"}], 
              "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"nd\[Psi]", "[", "t", "]"}], "=", "  ", 
            RowBox[{"int", " ", "dt"}]}], ";"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{
             RowBox[{"-", "Lm"}], "+", "dt"}], ",", "LM", ",", "dt"}], 
           "}"}]}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"nd\[Psi]", "[", "t", "]"}], "=", " ", 
            SuperscriptBox["E", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "-", "b"}], ")"}], " ", "t"}]]}], ";"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"-", "Lm"}], ",", 
            RowBox[{
             RowBox[{"-", "Lm"}], "+", "10"}], ",", "dt"}], "}"}]}], "]"}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"diffd\[Psi]", "[", "t", "]"}], "=", 
            RowBox[{
             RowBox[{"d\[Psi]", "[", "t", "]"}], "-", 
             RowBox[{"nd\[Psi]", "[", "t", "]"}]}]}], ";"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"-", "Lm"}], ",", "LM", ",", "dt"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"dmax", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"diffd\[Psi]", "[", "t", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", 
              RowBox[{"-", "Lm"}], ",", "LM", ",", "dt"}], "}"}]}], "]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"dsol", ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"tt", ",", 
              RowBox[{
               RowBox[{"diffd\[Psi]", "[", "tt", "]"}], "/", "dmax"}]}], 
             "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"tt", ",", 
              RowBox[{"-", "Lm"}], ",", "LM", ",", "dt"}], "}"}]}], "]"}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"dmaxite", ",", "dmax"}], "]"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"d\[Psi]", "[", "t", "]"}], "=", 
            RowBox[{"nd\[Psi]", "[", "t", "]"}]}], ";"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"-", "Lm"}], ",", "LM", ",", "dt"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"dP", "=", "0"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"dP", "+=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"m", "+", "1"}], ")"}], 
            RowBox[{"d\[Psi]", "[", "t", "]"}], 
            SuperscriptBox[
             RowBox[{"\[Psi]", "[", "t", "]"}], 
             RowBox[{"m", "+", "1"}]], " ", 
            SuperscriptBox["E", 
             RowBox[{"-", " ", 
              SuperscriptBox["E", "t"]}]], " ", 
            SuperscriptBox["E", "t"]}]}], " ", ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"-", "Lm"}], ",", "LM", ",", "dt"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"dP", "*=", 
         RowBox[{"(", "dt", ")"}]}], ";", " ", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"controllare", " ", "la", " ", "formula"}], ",", " ", 
          RowBox[{
          "manca", " ", "un", " ", "pezzo", " ", "che", " ", "dovrebbe", " ", 
           "dare", " ", "correzioni", " ", "regolari", " ", "in", " ", 
           "H"}]}], "  ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"dPite", ",", "dP"}], "]"}], ";"}]}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], ")"}]}], 
  "\[IndentingNewLine]"}]], "Input",
